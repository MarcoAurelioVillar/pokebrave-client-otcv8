TurnOrderBar < Panel
  background-color: #00000060
  border-width: 1
  border-color: #2a2a2a

  Label
    id: title
    text-align: left
    text: Turn Order
    margin: 2 0 0 8
    anchors.top: parent.top
    anchors.left: parent.left
    width: 100

  Panel
    id: slots
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    anchors.left: title.right
    margin: 2 4 2 4
    layout:
      type: horizontalBox
      spacing: 4

TurnOrderSlot < UIWidget
  background-color: #1a1a1a80
  border-width: 1
  border-color: #444444
  width: 80
  height: 18
  text-align: center
