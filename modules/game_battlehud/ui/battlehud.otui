Window
  id: battleHudWindow
  text: Battle HUD
  size: 760 420
  anchors.centerIn: parent
  focusable: true
  enabled: true

  Label
    id: turnLabel
    text-align: center
    text: Turn 1
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8

  Label
    id: statusLabel
    text-align: center
    text: Waiting opponent...
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4

  Label
    id: deadlineLabel
    text-align: right
    text-color: #f0a020
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 16
    width: 80
    text: ''

  TurnOrderBar
    id: turnOrderBar
    anchors.top: statusLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    width: 720
    height: 24

  LifeBarPanel
    id: opponentLifeBar
    anchors.top: turnOrderBar.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 12
    width: 360
    height: 64

  LifeBarPanel
    id: playerLifeBar
    anchors.top: opponentLifeBar.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 12
    width: 360
    height: 64

  TextLogPanel
    id: textLog
    anchors.top: turnOrderBar.bottom
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-right: 12
    margin-bottom: 156
    width: 340

  Panel
    id: actionList
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 12
    margin-right: 12
    width: 340
    height: 140
    background-color: #00000080
    border-width: 1
    border-color: #2a2a2a

    Label
      id: actionTitle
      text-align: center
      text: Your Turn
      margin: 4 0 0 0
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    Button
      id: moveBtn
      anchors.top: actionTitle.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 12
      width: 130
      height: 32
      text: Move

    Button
      id: itemBtn
      anchors.top: actionTitle.bottom
      anchors.right: parent.right
      margin-top: 8
      margin-right: 12
      width: 130
      height: 32
      text: Item

    Button
      id: switchBtn
      anchors.top: moveBtn.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 12
      width: 130
      height: 32
      text: Switch

    Button
      id: surrenderBtn
      anchors.top: itemBtn.bottom
      anchors.right: parent.right
      margin-top: 8
      margin-right: 12
      width: 130
      height: 32
      text: Surrender

  TargetSelectorPanel
    id: targetSelector
    visible: false
    anchors.fill: parent
